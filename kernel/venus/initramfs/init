#!/bin/sh
# venus initramfs /init  —— 双系统引导
#
# 优先级:
#   1) /dev/sda34  ext4 标签 nixos   → NixOS（/nix 存在且 /sbin/init 存在）
#   2) /dev/sda29  ext4 标签 venusroot → Alpine 救援系统（/venus-root 标记）
#   3) 都失败 → 在内存里起一份 Alpine（保证任何情况下都能调）
BB=/bin/busybox

$BB --install -s /bin 2>/dev/null
mount -t proc proc /proc 2>/dev/null
mount -t sysfs sysfs /sys 2>/dev/null
mount -t devtmpfs devtmpfs /dev 2>/dev/null
mkdir -p /newroot /tmp 2>/dev/null


# ---- 在 initramfs 里就把 USB ACM 串口建起来 ----
# 目的: 让 console=ttyGS0 能挂上，这样系统切进 NixOS 之后
#       systemd 的输出也能从串口看到（否则 NixOS 起不来时完全瞎）。
setup_acm() {
  mount -t configfs none /sys/kernel/config 2>/dev/null
  UDC=$($BB ls /sys/class/udc 2>/dev/null | $BB head -1)
  [ -n "$UDC" ] || return 1
  G=/sys/kernel/config/usb_gadget/venus
  $BB mkdir -p "$G" "$G/strings/0x409" "$G/configs/c.1/strings/0x409" 2>/dev/null
  echo 0x18d1 > "$G/idVendor" 2>/dev/null
  echo 0x4ee1 > "$G/idProduct" 2>/dev/null
  echo 0x0100 > "$G/bcdDevice" 2>/dev/null
  echo 0x0200 > "$G/bcdUSB" 2>/dev/null
  echo venus-m1 > "$G/strings/0x409/serialnumber" 2>/dev/null
  echo Xiaomi > "$G/strings/0x409/manufacturer" 2>/dev/null
  echo venus > "$G/strings/0x409/product" 2>/dev/null
  echo ACM > "$G/configs/c.1/strings/0x409/configuration" 2>/dev/null
  echo 250 > "$G/configs/c.1/MaxPower" 2>/dev/null
  $BB mkdir -p "$G/functions/acm.GS0" 2>/dev/null
  $BB ln -sf "$G/functions/acm.GS0" "$G/configs/c.1/acm.GS0" 2>/dev/null
  echo "$UDC" > "$G/UDC" 2>/dev/null
  return $?
}
setup_acm && echo "[initramfs] USB ACM 串口已就绪: /dev/ttyGS0"

# 等 UFS 探测完成（QMP PHY probe 异步）
i=0
while [ $i -lt 20 ]; do
  [ -b /dev/sda34 ] && break
  $BB sleep 1
  i=$((i+1))
done

boot_nixos() {
  mount -t ext4 -o rw /dev/sda34 /newroot 2>/dev/null || return 1
  # NixOS 的系统入口不是 /sbin/init, 而是 system profile 里的 init。
  # 注意: profile 里的符号链接是**绝对路径**(/nix/store/...), 直接在新根外面测
  # `-x /newroot/.../system/init` 会被内核解析到 initramfs 自己的 /nix 上而失败,
  # 必须手工顺着两级链接解析。
  prof=$(readlink /newroot/nix/var/nix/profiles/system 2>/dev/null)
  sysp=$(readlink "/newroot/nix/var/nix/profiles/$prof" 2>/dev/null)
  if [ -z "$sysp" ] || [ ! -x "/newroot$sysp/init" ]; then
    echo "[initramfs] NixOS 系统链接解析失败 (prof=$prof sysp=$sysp)"
    umount /newroot 2>/dev/null
    return 1
  fi
  echo "[initramfs] NixOS 系统: $sysp"
  echo "[initramfs] NixOS 根已挂载, 准备 switch_root"

  # NixOS stage-1 会做的事: 把 /run /dev/pts /dev/shm /sys/fs/cgroup 备好
  mkdir -p /newroot/run /newroot/dev/pts /newroot/dev/shm /newroot/tmp 2>/dev/null
  mount --move /dev /newroot/dev 2>/dev/null
  mount --move /proc /newroot/proc 2>/dev/null
  mount --move /sys /newroot/sys 2>/dev/null
  mount -t tmpfs -o mode=0755 tmpfs /newroot/run 2>/dev/null
  mount -t devpts devpts /newroot/dev/pts 2>/dev/null
  mount -t tmpfs -o mode=1777,nosuid,nodev tmpfs /newroot/dev/shm 2>/dev/null
  mount -t cgroup2 none /newroot/sys/fs/cgroup 2>/dev/null

  # 把 busybox 和引导包装脚本写进 NixOS 根(ext4, switch_root 之后仍然在)，
  # 目的是让系统阶段的输出全部打到串口，并且 systemd 失败时能落进救援 shell。
  $BB cp $BB /newroot/venus-busybox 2>/dev/null
  chmod +x /newroot/venus-busybox 2>/dev/null
  cat > /newroot/venus-boot.sh <<'EOSH'
#!/venus-busybox sh
/venus-busybox --install -s /venus-bin 2>/dev/null
export PATH=/venus-bin:/run/current-system/sw/bin:/usr/bin:/bin
exec 0</dev/ttyGS0 1>/dev/ttyGS0 2>&1 || exec 1>/dev/console 2>&1
echo
echo "=== VENUS: 进入 NixOS 系统阶段 ==="
echo "profile: $(readlink /nix/var/nix/profiles/system)"
( /venus-busybox dmesg 2>/dev/null | tail -5 ) 
echo "--- 启动 systemd ---"
/nix/var/nix/profiles/system/init
rc=$?
echo "!!! systemd 退出/失败, 状态码 $rc"
echo "--- 落到救援 shell (WiFi 未起时从这里诊断) ---"
exec /venus-busybox sh -i
EOSH
  chmod +x /newroot/venus-boot.sh 2>/dev/null

  exec switch_root /newroot /venus-boot.sh
}

boot_alpine() {
  mount -t ext4 -o rw /dev/sda29 /newroot 2>/dev/null || return 1
  if [ -f /newroot/venus-root ] && [ -x /newroot/bin/busybox ]; then
    mkdir -p /newroot/dev /newroot/proc /newroot/sys /newroot/tmp /newroot/run 2>/dev/null
    mount --move /dev /newroot/dev 2>/dev/null
    mount --move /proc /newroot/proc 2>/dev/null
    mount --move /sys /newroot/sys 2>/dev/null
    exec switch_root /newroot /venus-init.disk
  fi
  umount /newroot 2>/dev/null
  return 1
}

boot_nixos || boot_alpine || true

# 兜底: 内存里的 Alpine（/venus-init-ram 会拉起同样的调试通道）
exec /venus-init-ram
