CONFIG_PSTORE=y
CONFIG_PSTORE_RAM=y
CONFIG_PSTORE_CONSOLE=y
CONFIG_PSTORE_PMSG=y
# 7.2.6 起 pstore 只剩一个压缩开关 CONFIG_PSTORE_COMPRESS（fs/pstore/Kconfig:24），
# 旧的 CONFIG_PSTORE_DEFLATE_COMPRESS 已没有 config 定义，写了会被 olddefconfig 静默丢弃。
CONFIG_PSTORE_COMPRESS=y
CONFIG_MTD=y
CONFIG_MTD_BLOCK2MTD=y
# 正确的符号是 CONFIG_MTD_OOPS（drivers/mtd/Kconfig:169）；MTD_MTDOOPS 从来没有存在过。
CONFIG_MTD_OOPS=y
CONFIG_NETCONSOLE=y
CONFIG_NETCONSOLE_DYNAMIC=y
CONFIG_KGDB=y
CONFIG_KGDB_SERIAL_CONSOLE=y
CONFIG_DEBUG_INFO=y
CONFIG_DEBUG_INFO_DWARF5=y
CONFIG_DYNAMIC_DEBUG=y
CONFIG_FTRACE=y
CONFIG_FUNCTION_TRACER=y
CONFIG_MAGIC_SYSRQ=y
CONFIG_HARDLOCKUP_DETECTOR=y
CONFIG_BOOTPARAM_HARDLOCKUP_PANIC=y
CONFIG_DETECT_HUNG_TASK=y
CONFIG_DEFAULT_HUNG_TASK_TIMEOUT=30
