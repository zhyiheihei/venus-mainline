#!/bin/sh
# venus M1 init v4: 黑匣子 + 永不自杀
# - ramoops 已改到真地址 0xa9000000 (EvoX /dev/pmsg0 可读全文)
# - 不再 reboot -f (不烧槽位 tries), 无 UDC 则永久驻留等待
export PATH=/bin:/sbin

# pdx206 同款第一步: 释放 busybox 全部 applet(mount/dd/ip/telnetd 否则不存在!)
busybox --install -s /bin

mount -t proc proc /proc
mount -t sysfs sysfs /sys
mount -t devtmpfs devtmpfs /dev 2>/dev/null || mdev -s
K() { echo "venus-init: $*" > /dev/kmsg 2>/dev/null; echo "venus-init: $*"; }

K "=== init v4 start ==="
if [ -c /dev/watchdog ]; then (watchdog -t 5 /dev/watchdog &) ; K "watchdog pet started"; fi
mkdir -p /sys/kernel/config
mount -t configfs none /sys/kernel/config 2>/dev/null
K "configfs: $(mount | grep -c configfs) mounted"
mkdir -p /dev/pts && mount -t devpts devpts /dev/pts
mount -t pstore pstore /sys/fs/pstore 2>/dev/null

# 上一轮现场 (console-ramoops 在 0xa9000000)
if ls /sys/fs/pstore/console-ramoops* >/dev/null 2>&1; then
  K "=== PREVIOUS BOOT TAIL ==="
  K "$(tail -c 300 /sys/fs/pstore/console-ramoops* 2>/dev/null | tr '\n' '|')"
else
  K "no ramoops visible"
fi

# 上一轮现场: /dev/pmsg0 = 2MB 内存环(温重启不丢), 立即抄进 UFS 尾部
sleep 3
if [ -c /dev/pmsg0 ]; then
  K "pmsg0 present, archiving previous boot log"
  SZ0=$(cat /sys/class/block/sda34/size 2>/dev/null)
  if [ -n "$SZ0" ]; then
    tail -c 500000 /dev/pmsg0 > /tmp/prev.log 2>/dev/null
    SZ=$(cat /sys/class/block/sda34/size 2>/dev/null)
    dd if=/tmp/prev.log of=/dev/block/sda34 bs=512 seek=$((SZ-1024)) conv=notrunc 2>/dev/null
    K "prev log archived to ufs tail ($?)"
  else
    K "no sda34 size - ufs not probed?"
  fi
else
  K "no pmsg0"
fi
K "block: $(ls /dev/sda* 2>/dev/null | tr '\n' ' ') | udc: $(ls /sys/class/udc 2>/dev/null | tr '\n' ' ')"

# 时间信标: init 活着 → 45s 后确定性 reboot(fastboot 可观测);
# 现场快照遍历所有块设备的 LBA0(不假设 userdata 名称)
(
  sleep 2
  {
    echo "=== VENUS MARKER v12 $(date) ==="
    echo "block devs: $(ls /dev/sd* /dev/mmcblk* 2>/dev/null | tr '\n' ' ')"
    echo "udc: $(ls /sys/class/udc 2>/dev/null | tr '\n' ' ')"
    echo "configfs mounts: $(mount | grep -c configfs)"
    dmesg | tail -40
    echo "=== END MARKER ==="
  } > /tmp/marker.txt 2>&1
  for B in /dev/sd[a-z] /dev/sd[a-z][a-z] /dev/mmcblk*; do
    [ -b "$B" ] || continue
    dd if=/tmp/marker.txt of=$B bs=4096 seek=0 conv=notrunc 2>/dev/null
  done
  sleep 43
  K "BEACON: 45s reached, rebooting now"
  sync
  reboot -f
  
) &

# UFS 日志通道 v2: misc 分区偏移 4KB 起(BCB 之后), F2FS 永不碰
(
  sleep 5
  while :; do
    dmesg > /tmp/d.log 2>/dev/null
    echo "venus-init: logdump t=${T}s alive" >> /tmp/d.log
    dd if=/tmp/d.log of=/dev/block/by-name/misc bs=1024 seek=4 conv=notrunc 2>/dev/null
    sleep 15
  done
) &

G=/sys/kernel/config/usb_gadget/g1
mkdir -p "$G"
echo 0x18d1 > "$G/idVendor"
echo 0x4ee1 > "$G/idProduct"
mkdir -p "$G/strings/0x409" "$G/configs/c.1"
echo "venus-bringup" > "$G/strings/0x409/product"
mkdir "$G/functions/ncm.usb0" "$G/functions/acm.ttyGS0" 2>/dev/null
K "functions: $(ls $G/functions/ 2>/dev/null | tr '\n' ' ')"
ln -sf "$G/functions/ncm.usb0" "$G/configs/c.1/f1" 2>/dev/null
ln -sf "$G/functions/acm.ttyGS0" "$G/configs/c.1/f2" 2>/dev/null

# 无限耐心等 UDC
T=0
while :; do
  UDC=$(ls /sys/class/udc 2>/dev/null | head -1)
  if [ -n "$UDC" ]; then
    if echo "$UDC" > "$G/UDC" 2>/dev/null; then break; fi
  fi
  sleep 2
  T=$((T+2))
  if [ $((T % 20)) -eq 0 ]; then
    K "waiting udc (${T}s); dwc3 nodes: $(ls /sys/bus/platform/devices/ | grep -c a6)"
  fi
done
K "UDC BOUND after ${T}s: $UDC"

ip link set usb0 up 2>/dev/null
ip addr add 10.15.0.2/24 dev usb0 2>/dev/null
telnetd -l /bin/sh 2>/dev/null && K "telnetd up"
(
  while :; do
    setsid sh -c 'exec sh </dev/ttyGS0 >/dev/ttyGS0 2>&1'
    sleep 2
  done
) &
K "=== UP: telnet 10.15.0.2 / ttyACM0 ==="

while :; do sleep 3600; done
